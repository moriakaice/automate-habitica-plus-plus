# Copy this file to .env and fill in your Habitica credentials.
# .env is gitignored – never commit real credentials.
# You find all both values on https://habitica.com/user/settings/siteData

# Your Habitica User ID (Settings → Site Data)
USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your Habitica API Token (Settings → Site Data)
API_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Populated automatically by npm run setup after the first successful deploy.
WORKER_URL=
