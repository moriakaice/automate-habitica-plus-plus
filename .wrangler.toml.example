name = "automate-habitica"
main = "worker.ts"
compatibility_date = "2026-09-15"

# Cron trigger: runs processTrigger() every X minutes - 6 is default
[triggers]
crons = ["*/6 * * * *"]

# The setup command adds the KV namespace binding to this generated configuration.

# ─────────────────────────────────────────────────────────────────
# Secrets – set via CLI (never hardcode credentials here):
#   wrangler secret put USER_ID
#   wrangler secret put API_TOKEN
#   wrangler secret put WORKER_URL   <- your deployed worker URL
# ─────────────────────────────────────────────────────────────────

[observability.logs]
enabled = true
invocation_logs = true